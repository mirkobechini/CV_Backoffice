APP_NAME="CV Backoffice"
APP_VERSION=1.2.54
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Per sviluppo locale usa SQLite, per produzione Laravel Cloud imposta MySQL
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Laravel Cloud imposta MAIL_URL automaticamente via SMTP integrato
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@cvbackoffice.it"
MAIL_FROM_NAME="${APP_NAME}"

# Disco per i file caricati dagli utenti (carta di circolazione, foto
# guasti). "public" in locale, "s3" in produzione (vedi R2_* sotto):
# il disco locale su Laravel Cloud non è raggiungibile dal layer che
# serve i file statici, quindi in produzione va impostato a "s3".
UPLOADS_DISK=public

# Cloudflare R2 (storage compatibile S3), usato solo se UPLOADS_DISK=s3.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_URL=
R2_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Vision LLM per la scansione del libretto di circolazione (creazione
# veicolo). Compatibile con qualunque provider che parli il formato
# chat-completions di OpenAI (OpenRouter di default, ma anche OpenAI
# direttamente cambiando solo BASE_URL/MODEL).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
